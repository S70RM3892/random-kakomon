# Supabase のプロジェクト設定 > API からコピーする。
# このファイルは雛形。実際の値は .env.local（ローカル）と Vercel の環境変数に入れ、
# リポジトリには絶対にコミットしない。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 公開用のキー。ブラウザに配られる前提の値で、アクセス制御は RLS 側でやる。
# 新しいプロジェクトは sb_publishable_... が発行される。
# 2025年より前に作ったプロジェクトは eyJ... で始まる anon キー（どちらでも動く）。
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# scripts/seed.ts だけが使う秘密のキー。新しいプロジェクトは sb_secret_...、
# 古いプロジェクトは service_role キー（eyJ...）。
# 公開してはいけないので NEXT_PUBLIC_ を付けないこと。
# ローカルでシードを流すときだけ設定する。
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
